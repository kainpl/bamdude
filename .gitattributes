# Force CRLF line endings for Windows batch files so cmd.exe can parse them
# regardless of the user's core.autocrlf setting.
*.bat text eol=crlf

# Force LF for shell scripts. With core.autocrlf=true (the Windows default)
# a checkout rewrites them to CRLF, which turns the shebang into
# `#!/bin/sh\r` — Linux then looks for an interpreter whose name ends in a
# carriage return and reports "no such file or directory". The repository
# already stores LF; this makes the working copy match on every platform.
#
# Concretely: without it, `docker build` on Windows produces an image whose
# entrypoint cannot exec, and install.sh copied from such a checkout fails
# the same way. CI never saw it because Linux runners do not convert.
*.sh text eol=lf

# The part-render bundle is checked against the sha256 its build recorded
# (spec §5.5): an EOL conversion on a Windows clone would make every install
# report bundle_mismatch.
backend/app/data/part_render/** -text

# STEP-preview fixtures carry their own sha256 and byte counts in expected.json (independent oracle, plan S3), and
# scripts/pin_step_runtime.py --check compares the committed catalog text: keep both byte-exact on every clone.
backend/tests/fixtures/step/** -text
# ...except the generators that write them: ordinary source, LF in the repository like every other .py.
backend/tests/fixtures/step/generators/** text eol=lf
backend/app/data/step_runtime_*.json -text
# The probe's STEP fixture is a copy of an authored one, and the CAD component's licence texts must stay the bytes
# their upstreams ship (a re-sync is diffed against them, as OFL.txt is).
backend/app/data/step_probe/** -text
backend/app/data/step_runtime_notices/** -text
